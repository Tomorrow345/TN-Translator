<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TN_Translator</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>TN-Translator-Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Clean.png" />
    <None Remove="code.png" />
    <None Remove="copy.png" />
    <None Remove="Flag.png" />
    <None Remove="TN-Translator-Logo.png" />
    <None Remove="translate.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Clean.png" />
    <Resource Include="code.png" />
    <Resource Include="copy.png" />
    <Resource Include="Flag.png" />
    <Resource Include="TN-Translator-Icon.ico" />
    <Resource Include="TN-Translator-Logo.png" />
    <Resource Include="translate.png" />
  </ItemGroup>

</Project>
